{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScopeDisabled",
    "docker:disable"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": ["before 4am on monday"],
  "groupName": "all dependencies",
  "groupSlug": "all",
  "postUpdateOptions": ["gomodTidy"],
  "ignoreDeps": ["github.com/netapp/ontap-mcp"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "all dependencies",
      "groupSlug": "all",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "integration/ is a separate module that consumes the root module from disk (replace github.com/netapp/ontap-mcp => ../), so root dependency bumps propagate into its indirect requirements; bump them in the same PR or `just lint` breaks there",
      "matchManagers": ["gomod"],
      "matchFileNames": ["integration/go.mod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    }
  ],
  "separateMajorMinor": false
}
